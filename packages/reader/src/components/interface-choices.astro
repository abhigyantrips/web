---
import { INTERFACE_ORIGINS, type ReaderInterface } from "../interface";
interface Props {
	interface: ReaderInterface;
}
const computer = import.meta.env.PUBLIC_READER_COMPUTER_ORIGIN;
const mobile = import.meta.env.PUBLIC_READER_MOBILE_ORIGIN;
const origins =
	computer && mobile
		? { computer: new URL(computer).origin, mobile: new URL(mobile).origin }
		: INTERFACE_ORIGINS;
const path =
	Astro.url.pathname === "/desktop/"
		? "/"
		: Astro.url.pathname === "/credits/"
			? "/colophon/"
			: Astro.url.pathname;
function selection(target: ReaderInterface | "automatic") {
	const url = new URL(
		path,
		target === "automatic" || target === Astro.props.interface ? Astro.url.origin : origins[target]
	);
	url.search = Astro.url.search;
	url.hash = Astro.url.hash;
	url.searchParams.set("interface", target);
	return url.href;
}
---

<nav aria-label="Reading interface" class="choice-list">
	<a href={selection("computer")}>Use Computer</a>
	<a href={selection("mobile")}>Use Mobile</a>
	<a href={selection("automatic")}>Automatic</a>
</nav>

<style>
	.choice-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-block: 1rem;
	}
	a {
		display: inline-block;
		padding: 0.65rem 0.85rem;
		border: 1px solid currentColor;
		border-radius: 0.5rem;
		text-underline-offset: 0.2em;
	}
</style>
