---
import MobileLayout from "../layouts/mobile-layout.astro";
import { applications } from "../data/applications";
---

<MobileLayout>
	<section class="welcome">
		<p class="eyebrow">Abhigyan Trips / Personal space</p><h1>My world,<br />in your pocket.</h1><p>
			Notes from life, things I’m making,<br />and rabbit holes worth falling into.
		</p><span class="handwritten" aria-hidden="true">make yourself at home ↙</span>
	</section>
	<nav class="app-grid" aria-label="Applications">
		{
			applications.map((app, index) => (
				<a class="app-card" href={`/${app.id}/`} style={`--app-color: var(--app-${index % 4})`}>
					<>
						<span class="app-glyph" aria-hidden="true">
							{app.glyph}
						</span>
						<h2>{app.title}</h2>
						<p>{app.description}</p>
						<span class="app-arrow" aria-hidden="true">
							↗
						</span>
					</>
				</a>
			))
		}
	</nav>
</MobileLayout>
