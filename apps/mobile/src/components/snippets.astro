---
import { formatSnippetDate, getSnippetFeed } from "@abhi/reader/snippets";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
interface Props {
	collectionId?: string;
	directory?: boolean;
}
const { collectionId, directory } = Astro.props;
const folders = await getCollection("snippetCollections");
const entries = await Promise.all(
	(directory ? [] : await getSnippetFeed(collectionId)).map(async (item) => ({
		...item,
		Content: (await render(item.post)).Content,
		...formatSnippetDate(item.post.data.date),
	}))
);
---

<nav class="choice-list" aria-label="Snippets navigation">
	<a href="/snippets/">All snippets</a><a href="/snippets/folders/">Collections</a>
</nav>
{
	directory ? (
		<ul class="entry-list">
			{folders.map((folder) => (
				<li>
					<a href={`/snippets/${folder.data.permalink}/`}>
						<h2>{folder.data.name}</h2>
						<p>{folder.data.description}</p>
					</a>
					<a href={`https://abhi.now/snippets/${folder.data.permalink}/feed.xml`}>
						Follow via RSS ↗
					</a>
				</li>
			))}
		</ul>
	) : (
		entries.map(({ post, collection, Content, publishedDate, publishedTime }) => (
			<article class="snippet" id={post.id}>
				<>
					<header>
						<a href={`/snippets/${collection.data.permalink}/`}>{collection.data.name}</a>
					</header>
					<div class="prose-content">
						{post.data.type === "photos" && (
							<Image
								src={post.data.image}
								alt={post.data.imageAlt}
								widths={[320, 480, 640]}
								sizes="calc(100vw - 40px)"
								loading="lazy"
							/>
						)}
						<Content />
					</div>
					<footer>
						<a href={`#${post.id}`}>
							<time datetime={post.data.date.toISOString()}>
								{publishedDate} · {publishedTime}
							</time>
						</a>
					</footer>
				</>
			</article>
		))
	)
}
{!directory && entries.length === 0 && <p>No snippets yet.</p>}
